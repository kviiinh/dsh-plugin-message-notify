{
  "name": "dsh-plugin-message-notify",
  "version": "1.1.1",
  "description": "DSH 有回复、授权请求、提问或计划确认时在屏幕右下角弹卡片：显示工作区、对话主题与摘要，带「查看」「关闭」按钮，收起时长、提醒时机、主题与圆点颜色都可调。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "notification",
    "popup"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "popup.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "message-notify-flow.png",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
